direction: down

# --- CLASES Y ESTILOS ---
classes: {
  agent: {
    shape: rectangle
    style: { fill: "#2563eb"; stroke: "#1e3a8a"; border-radius: 8; font-color: white; bold: true }
  }
  human: {
    shape: oval
    style: { fill: "#facc15"; stroke: "#ca8a04"; stroke-width: 2; font-color: "#713f12"; bold: true }
  }
  system: {
    shape: cylinder
    style: { fill: "#64748b"; stroke: "#334155"; font-color: white; bold: true }
  }
  happy_path: {
    style: { stroke: "#10b981"; stroke-width: 2 }
  }
  loop: {
    style: { stroke: "#ef4444"; stroke-width: 2; stroke-dash: 5; animated: true }
  }
}

# --- 1. PIPELINE DE DISCOVERY ---
Discovery Pipeline: {
  style: { fill: "#f8fafc"; stroke: "#cbd5e1"; border-radius: 10 }
  
  PS: Product Strategist (Retador) { class: agent }
  CP_Strat: Checkpoint Estrategia (Humano) { class: human }
  PO: Product Owner (Escriba) { class: agent }
  CP_Backlog: Checkpoint Backlog (Humano) { class: human }
  PA_Sync: Project Assistant (Sync) { class: agent }

  # Camino Feliz
  PS -> CP_Strat: WAITING_FOR_APPROVAL\n(Propuesta MVP) { class: happy_path }
  CP_Strat -> PO: APPROVED { class: happy_path }
  PO -> CP_Backlog: WAITING_FOR_APPROVAL\n(BDDs) { class: happy_path }
  CP_Backlog -> PA_Sync: APPROVED { class: happy_path }

  # Bucles de Rechazo en Discovery
  CP_Strat -> PS: NEEDS_REVISION\n(Ajustar alcance) { class: loop }
  CP_Backlog -> PO: NEEDS_REVISION\n(Corregir BDDs) { class: loop }
}

# --- FRONTERA ---
ADO: Azure DevOps { class: system }

Discovery Pipeline.PA_Sync -> ADO: Crea Work Items { class: happy_path }

# --- 2. PIPELINE DE DELIVERY ---
Delivery Pipeline: {
  style: { fill: "#f0fdf4"; stroke: "#bbf7d0"; border-radius: 10 }
  
  PA_Intake: Project Assistant (Intake) { class: agent }
  SA: Software Architect { class: agent }
  CP_Design: Checkpoint Diseño (Humano) { class: human }
  QA: QA Analyst { class: agent }
  TL: Tech Lead { class: agent }
  CP_Plan: Checkpoint Plan (Humano) { class: human }
  DEV: Developer (+ Test Dev) { class: agent }
  CR: Code Reviewer { class: agent }
  CP_Merge: Checkpoint Merge (Humano) { class: human }
  PA_Close: Project Assistant (Close) { class: agent }

  # Camino Feliz
  PA_Intake -> SA: Contexto PBI { class: happy_path }
  SA -> CP_Design: WAITING_FOR_APPROVAL { class: happy_path }
  CP_Design -> QA: APPROVED { class: happy_path }
  QA -> TL: COMPLETED { class: happy_path }
  TL -> CP_Plan: COMPLETED { class: happy_path }
  CP_Plan -> DEV: APPROVED { class: happy_path }
  DEV -> CR: COMPLETED { class: happy_path }
  CR -> CP_Merge: MERGE_READY { class: happy_path }
  CP_Merge -> PA_Close: APPROVED { class: happy_path }

  # Bucles Internos de Delivery
  CP_Design -> SA: NEEDS_REVISION { class: loop }
  QA -> SA: design_not_testable { class: loop }
  TL -> SA: design { class: loop }
  TL -> QA: test-cases { class: loop }
  CP_Plan -> TL: NEEDS_REVISION { class: loop }
  CR -> DEV: MERGE_WITH_FIXES { class: loop }
  CP_Merge -> CR: NEEDS_REVISION { class: loop }
}

ADO -> Delivery Pipeline.PA_Intake: Descarga PBI { class: happy_path }

# --- MACRO-BUCLES Y ESCALACIONES ---
Delivery Pipeline.DEV -> Delivery Pipeline.QA: Escalación (SPEC_CONFLICT / TEST_BUG) { class: loop }
Delivery Pipeline.DEV -> Delivery Pipeline.TL: Escalación (IMPLEMENTATION_BLOCK) { class: loop }
Delivery Pipeline.DEV -> Delivery Pipeline.SA: Escalación (CONVENTION_CONFLICT) { class: loop }
Delivery Pipeline.CR -> Delivery Pipeline.SA: DO_NOT_MERGE (Rediseño) { class: loop }