{
  "name": "admin-panel",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:es": "ng serve --configuration=es",
    "build": "ng build",
    "build:es": "ng build --configuration=es",
    "extract-i18n": "ng extract-i18n",
    "i18n:check": "awk -F'\"' '/unit id=/{print $2}' src/locale/messages.xlf | sort > /tmp/i18n_en.txt && awk -F'\"' '/unit id=/{print $2}' src/locale/messages.es.xlf | sort > /tmp/i18n_es.txt && echo '--- IDs faltantes en messages.es.xlf ---' && comm -23 /tmp/i18n_en.txt /tmp/i18n_es.txt; rm -f /tmp/i18n_en.txt /tmp/i18n_es.txt",
    "i18n:sync": "npm run extract-i18n && npm run i18n:check",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "list": "find . \\( -path './node_modules' -o -path './.vscode' -o -path './.git' -o -path './.angular' -o -path './dist' \\) -prune -false -o -print | sed 's|^\\./||' | sort | awk -F/ '{indent=\"\"; for(i=1;i<NF;i++) indent=indent\"  \"; print indent $NF}'",
    "list:tree": "tree -I 'node_modules|dist|.git|.vscode|.angular'",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.13",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/localize": "^20.3.17",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "highlight.js": "^11.11.1",
    "ngx-highlightjs": "^14.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.3",
    "@analogjs/vitest-angular": "^2.2.3",
    "@angular/build": "^20.3.6",
    "@angular/cli": "^20.3.6",
    "@angular/compiler-cli": "^20.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "angular-eslint": "21.0.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-rxjs-x": "^0.9.4",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4",
    "vitest": "^4.0.18"
  }
}
