{
  "name": "admin-panel",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:es": "ng serve --configuration=es",
    "build": "ng build",
    "build:es": "ng build --configuration=es",
    "extract-i18n": "ng extract-i18n",
    "i18n:check": "awk -F'\"' '/unit id=/{print $2}' src/locale/messages.xlf | sort > /tmp/i18n_en.txt && awk -F'\"' '/unit id=/{print $2}' src/locale/messages.es.xlf | sort > /tmp/i18n_es.txt && echo '--- IDs faltantes en messages.es.xlf ---' && comm -23 /tmp/i18n_en.txt /tmp/i18n_es.txt; rm -f /tmp/i18n_en.txt /tmp/i18n_es.txt",
    "i18n:sync": "npm run extract-i18n && npm run i18n:check",
    "watch": "ng build --watch --configuration development",
    "list": "node scripts/list-tree.mjs --flat",
    "list:tree": "node scripts/list-tree.mjs",
    "list:clean": "node scripts/list-tree.mjs --ignore-ext=.spec.ts,.scss,.html",
    "list:ts-only": "node scripts/list-tree.mjs --only-ext=.ts",
    "list:models": "node scripts/list-tree.mjs --only-ext=.model.ts",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test": "npm run test:unit",
    "test:all": "npm run lint && npm run test:unit && npm run test:e2e",
    "test:ci": "npm run lint && npm run test:unit:coverage && npm run test:e2e",
    "dep:graph": "depcruise src/app --config .dependency-cruiser.js --output-type html > docs/dep-graph.html",
    "dep:archi": "depcruise src/app --config .dependency-cruiser.js --output-type archi > docs/dep-archi.dot && dot -T svg docs/dep-archi.dot -o docs/dep-archi.svg",
    "dep:graph:svg": "depcruise src/app --config .dependency-cruiser.js --output-type dot > docs/dep-graph.dot && dot -T svg docs/dep-graph.dot -o docs/dep-graph.svg",
    "dep:focus": "depcruise src/app --config .dependency-cruiser.js --output-type dot --focus",
    "dep:validate": "depcruise src/app --config .dependency-cruiser.js --output-type err",
    "dep:diagram": "depcruise src/app --config .dependency-cruiser.js --output-type mermaid > docs/arquitectura.md",
    "diagram:pipeline": "mmdc -i wip/pipeline-workflow.mmd -o wip/pipeline-workflow.svg -b transparent",
    "diagram:pipeline:png": "mmdc -i wip/pipeline-workflow.mmd -o wip/pipeline-workflow.png -w 2400",
    "diagram:pipeline:compact": "mmdc -i wip/pipeline-workflow-compact.mmd -o wip/pipeline-workflow-compact.svg -b transparent",
    "diagram:d1": "mmdc -i wip/pipeline-d1-overview.mmd -o wip/pipeline-d1-overview.svg -b transparent",
    "diagram:d2": "mmdc -i wip/pipeline-d2-exceptions.mmd -o wip/pipeline-d2-exceptions.svg -b transparent",
    "diagram:d3": "mmdc -i wip/pipeline-d3-resilience.mmd -o wip/pipeline-d3-resilience.svg -b transparent",
    "diagram:all": "npm run diagram:d1 && npm run diagram:d2 && npm run diagram:d3"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.13",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/localize": "^20.3.17",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "highlight.js": "^11.11.1",
    "ngx-highlightjs": "^14.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.3",
    "@analogjs/vitest-angular": "^2.2.3",
    "@angular/build": "^20.3.6",
    "@angular/cli": "^20.3.6",
    "@angular/compiler-cli": "^20.3.0",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/angular": "^18.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.0.18",
    "angular-eslint": "21.0.1",
    "autoprefixer": "^10.4.22",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-rxjs-x": "^0.9.4",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4",
    "vitest": "^4.0.18"
  }
}
