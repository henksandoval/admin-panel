flowchart TD

  %% ══════════════════════════════════════════════════════
  %% ENTRADA DEL PIPELINE
  %% ══════════════════════════════════════════════════════

  START(["🚀 Coordinator invocado
  start {issue-N}  ·  resume {issue-N}"])

  READ_STATE[/"📂 Lee pipeline-state.json + PIPELINE.md
  Primera acción en cada invocación"/]

  ROUTE{¿Pipeline
  interrumpido?}

  START --> READ_STATE --> ROUTE

  ROUTE -->|"pipeline nuevo"| PO_IN
  ROUTE -->|"status ≠ completed → retoma fase actual"| PHASE_JUMP["↩ Reanuda desde
  la fase registrada en
  pipeline-state.json"]

  PHASE_JUMP -.->|spec| PO_IN
  PHASE_JUMP -.->|design| ARCH_IN
  PHASE_JUMP -.->|tech-lead| TL_IN
  PHASE_JUMP -.->|qa| QA_IN
  PHASE_JUMP -.->|dev| DEV_IN
  PHASE_JUMP -.->|review| REV_IN

  %% ══════════════════════════════════════════════════════
  %% FASE 0 — SPEC (PO Agent)
  %% ══════════════════════════════════════════════════════

  subgraph F0["📋  FASE 0 — SPEC"]
    direction TB
    PO_IN(( ))
    PO["🤖 PO Agent — Sonnet
    ▸ Entrevista estructurada al humano
    ▸ Spec borrador con gaps [PENDIENTE: ...]
    ▸ Sección: Supuestos explicitados + nivel de confianza
    ▸ Sección: Estado del contexto"]

    PO_SCHEMA{"Coordinator valida:
    secciones [REQUERIDO]
    ≥3 criterios observables
    checklist completa"}

    PO_STATE[/"📝 Escribe: spec.md
    📊 Actualiza: pipeline-state.json
    ✅ Actualiza: PIPELINE.md"/]

    PO_IN --> PO --> PO_SCHEMA
    PO_SCHEMA -->|"schema inválido
    reinvoca con feedback"| PO
    PO_SCHEMA -->|schema ok| PO_STATE
  end

  PO_STATE --> PAUSE_1

  PAUSE_1[/"⏸ Escribe: waiting-for-approval.md
  Escribe: status = waiting_for_approval"/]

  PAUSE_1 --> CP1

  CP1{{"⚑  CHECKPOINT 1
  Humano revisa spec.md
  Primera línea del archivo:"}}

  CP1 -->|"&lt;!-- STATUS: NEEDS_REVISION --&gt;"| SPEC_FB["📝 Human escribe spec-feedback.md
  Coordinator reinvoca PO Agent
  con contexto adicional"]
  SPEC_FB --> MAX1{"ciclos >
  max_spec_revisions?"}
  MAX1 -->|no| PO_IN
  MAX1 -->|sí| BLOCKED

  CP1 -->|"&lt;!-- STATUS: APPROVED --&gt;
  &lt;!-- STATUS: APPROVED_WITH_CHANGES --&gt;"| DIFF1["🔀 git diff → detecta cambios humanos
  Si hay cambios: propaga diff al siguiente agente"]

  DIFF1 --> ARCH_IN

  %% ══════════════════════════════════════════════════════
  %% FASE 1 — DISEÑO (Architect Agent)
  %% ══════════════════════════════════════════════════════

  subgraph F1["🏛️  FASE 1 — DISEÑO"]
    direction TB
    ARCH_IN(( ))
    ARCH["🤖 Architect Agent — Sonnet
    ▸ Lee: spec.md  [contexto base]
    ▸ Propone 2-3 enfoques con trade-offs explícitos
    ▸ Sección obligatoria: Elementos UI observables
    ▸ Sección obligatoria: Comportamientos observables verificables
    ▸ Estimación de complejidad: simple / moderate / complex
    ▸ Si complex → produce implementation-slices.md"]

    ARCH_SCHEMA{"Coordinator valida:
    schema + checklist
    secciones obligatorias"}

    ARCH_STATE[/"📝 Escribe: design-decision.md
    📊 Actualiza: pipeline-state.json
    ✅ Actualiza: PIPELINE.md"/]

    ARCH_IN --> ARCH --> ARCH_SCHEMA
    ARCH_SCHEMA -->|schema inválido| ARCH
    ARCH_SCHEMA -->|ok| ARCH_STATE
  end

  ARCH_STATE --> PAUSE_2

  PAUSE_2[/"⏸ Escribe: waiting-for-approval.md
  status = waiting_for_approval"/]

  PAUSE_2 --> CP2

  CP2{{"⚑  CHECKPOINT 2
  Humano revisa design-decision.md"}}

  CP2 -->|"NEEDS_REVISION"| DESIGN_FB["📝 design-feedback.md
  Reinvoca Architect"]
  DESIGN_FB --> MAX2{"ciclos >
  max_design_revisions?"}
  MAX2 -->|no| ARCH_IN
  MAX2 -->|sí| BLOCKED

  CP2 -->|"APPROVED / APPROVED_WITH_CHANGES"| DIFF2["🔀 git diff → propaga cambios"]

  DIFF2 --> TL_IN

  %% ══════════════════════════════════════════════════════
  %% FASE 2 — VALIDACIÓN (Tech Lead Agent)
  %% ══════════════════════════════════════════════════════

  subgraph F2["🔍  FASE 2 — VALIDACIÓN TÉCNICA"]
    direction TB
    TL_IN(( ))
    TL["🤖 Tech Lead Agent — Sonnet  [framing adversarial]
    Lee: spec.md + design-decision.md + instruction files
    Acceso: listado de directorio del codebase

    ① Escribe el caso en CONTRA del diseño
    ② Evalúa checklist de auditoría fija:
       ☐ Violaciones de SOLID
       ☐ Acoplamiento fuera de architectural-principles.md
       ☐ Edge cases de spec no cubiertos en el diseño
       ☐ Impacto cross-feature no considerado
       ☐ Dependencias circulares potenciales
       ☐ Inconsistencias con styling / testing instructions
    ③ Escribe veredicto tras completar el caso en contra"]

    TL_SCHEMA{"Coordinator valida:
    todos los ítems del
    checklist marcados [x]"}

    TL_STATE[/"📝 Escribe: plan.md
    📊 Actualiza: pipeline-state.json
    ✅ Actualiza: PIPELINE.md
    ⚡ Sin checkpoint humano — fluye automáticamente"/]

    TL_IN --> TL --> TL_SCHEMA
    TL_SCHEMA -->|checklist incompleta| TL
    TL_SCHEMA -->|ok| TL_STATE
  end

  TL_STATE --> QA_IN

  %% ══════════════════════════════════════════════════════
  %% FASE 3 — TESTS (QA Agent)
  %% ══════════════════════════════════════════════════════

  subgraph F3["🧪  FASE 3 — TESTS"]
    direction TB
    QA_IN(( ))
    QA["🤖 QA Agent — Sonnet
    Lee: spec.md + design-decision.md  [contexto base]

    ▸ Produce test-scenarios.md:
      – Trazabilidad criterio de spec → escenario
      – Edge cases de la spec (explícitos) +
        edge cases inferidos (marcados como tales)
    ▸ Deriva data-testid desde 'Elementos UI observables'
      usando convención de testing.instructions.md
    ▸ Escribe *.spec.ts en FASE RED
    ▸ Declara número de tests que deben fallar"]

    QA_CHECK{"npm run test -- --run
    ¿Tests fallan por assertion?
    (no por compilación o setup)"}

    QA_STATE[/"📝 Escribe: test-scenarios.md
    📝 Escribe: *.spec.ts  [RED]
    📊 Actualiza: pipeline-state.json
    ✅ Actualiza: PIPELINE.md"/]

    QA_IN --> QA --> QA_CHECK
    QA_CHECK -->|"error de setup o compilación
    reinvoca con feedback"| QA
    QA_CHECK -->|"RED correcto  ✓"| QA_STATE
  end

  QA_STATE --> PAUSE_3

  PAUSE_3[/"⏸ Escribe: waiting-for-approval.md
  status = waiting_for_approval"/]

  PAUSE_3 --> CP3

  CP3{{"⚑  CHECKPOINT 3
  Humano revisa test-scenarios.md
  ⚠ No los .spec.ts — solo los escenarios"}}

  CP3 -->|"NEEDS_REVISION"| TEST_FB["📝 test-feedback.md
  Reinvoca QA Agent"]
  TEST_FB --> MAX3{"ciclos >
  max_test_revisions?"}
  MAX3 -->|no| QA_IN
  MAX3 -->|sí| BLOCKED

  CP3 -->|"APPROVED / APPROVED_WITH_CHANGES"| DIFF3["🔀 git diff → propaga cambios
  ⚠ Contrato aprobado = INVIOLABLE
  Ningún agente puede modificar tests
  sin nuevo checkpoint humano"]

  DIFF3 --> DEV_IN

  %% ══════════════════════════════════════════════════════
  %% FASE 4 — IMPLEMENTACIÓN (Dev Agent)
  %% ══════════════════════════════════════════════════════

  subgraph F4["⚙️  FASE 4 — IMPLEMENTACIÓN"]
    direction TB
    DEV_IN(( ))
    DEV["🤖 Dev Agent — Sonnet
    Lee: design-decision.md + test-scenarios.md + *.spec.ts
    Consulta codebase para micro-decisiones internas
    Documenta decisiones autónomas en dev-decisions.md

    Criterio de superficie observable:
    ▸ Decisión afecta solo lógica interna → autónomo + documenta
    ▸ Decisión afecta data-testid / API pública / contratos → escala"]

    DEV_RESULT{"npm run test ✅
    npm run build ✅
    npm run lint  ✅"}

    DEV_CLASSIFY{"Clasificar
    tipo de fallo"}

    DEV_ESC_QA["→ QA Agent
    dev-assessment.md
    SPEC_CONFLICT / TEST_BUG"]

    DEV_ESC_TL["→ Tech Lead / Architect
    dev-assessment.md
    IMPLEMENTATION_BLOCK"]

    DEV_ESC_PO["→ PO Agent
    dev-assessment.md
    AMBIGUOUS_REQUIREMENT"]

    DEV_ESC_REV["→ Reviewer  [árbitro]
    dev-assessment.md
    Fallo no clasificable"]

    DEV_MAX{"ciclos >
    max_dev_iterations?"}

    DEV_STATE[/"📝 Escribe: completion-report.md
    📝 Escribe: dev-decisions.md
    📊 Actualiza: pipeline-state.json
    ✅ Actualiza: PIPELINE.md
    ⚡ Sin checkpoint humano — fluye al Reviewer"/]

    DEV_IN --> DEV --> DEV_RESULT
    DEV_RESULT -->|"✅ verde"| DEV_STATE
    DEV_RESULT -->|"❌ falla"| DEV_CLASSIFY

    DEV_CLASSIFY --> DEV_ESC_QA
    DEV_CLASSIFY --> DEV_ESC_TL
    DEV_CLASSIFY --> DEV_ESC_PO
    DEV_CLASSIFY --> DEV_ESC_REV

    DEV_ESC_QA --> DEV_MAX
    DEV_ESC_TL --> DEV_MAX
    DEV_ESC_PO --> DEV_MAX
    DEV_ESC_REV --> DEV_MAX

    DEV_MAX -->|no| DEV
    DEV_MAX -->|sí| BLOCKED
  end

  DEV_STATE --> REV_IN

  %% ══════════════════════════════════════════════════════
  %% FASE 5 — REVISIÓN (Reviewer Agent)
  %% ══════════════════════════════════════════════════════

  subgraph F5["🔎  FASE 5 — REVISIÓN"]
    direction TB
    REV_IN(( ))
    REV["🤖 Reviewer Agent — Sonnet
    Lee: design-decision.md + completion-report.md + dev-decisions.md
    Acceso: git diff main...feature/branch

    ▸ Audita: SOLID, coupling, screaming architecture
    ▸ Audita: dev-decisions.md — decisiones autónomas del Dev
    ▸ Clasifica cada hallazgo:
      BLOQUEANTE  → violación arquitectónica, requiere rediseño
      MAYOR       → rework significativo sin cambiar diseño
      MENOR       → corrección puntual o recomendación
    ▸ Produce recomendación de merge explícita:
      MERGE_READY  /  MERGE_WITH_FIXES  /  DO_NOT_MERGE"]

    REV_ITER{"¿Hallazgos
    BLOQUEANTE?"}

    REV_FIX["Dev corrige MAYOR / MENOR
    sin retroceder fase
    → regresa al Reviewer"]

    REV_OK_STATE[/"📝 Escribe: review-report.md  [MERGE_READY]
    📊 Actualiza: pipeline-state.json  status=completed
    ✅ Actualiza: PIPELINE.md"/]

    REV_BLOCK_STATE[/"📝 Escribe: review-report.md  [DO_NOT_MERGE]
    📊 Actualiza: pipeline-state.json"/]

    REV_CYCLES{"ciclos >
    max_review_cycles?"}

    REV_IN --> REV --> REV_ITER
    REV_ITER -->|"MAYOR / MENOR
    MERGE_WITH_FIXES"| REV_FIX
    REV_FIX --> REV
    REV_ITER -->|"Sin BLOQUEANTE
    MERGE_READY"| REV_OK_STATE
    REV_ITER -->|"BLOQUEANTE
    DO_NOT_MERGE"| REV_BLOCK_STATE
    REV_BLOCK_STATE --> REV_CYCLES
    REV_CYCLES -->|sí| BLOCKED
  end

  REV_OK_STATE --> DONE

  REV_BLOCK_STATE --> PAUSE_4

  PAUSE_4[/"⏸ Escribe: waiting-for-approval.md
  status = waiting_for_approval"/]

  PAUSE_4 --> CP4

  CP4{{"⚑  CHECKPOINT 4  [solo si hay BLOQUEANTE]
  Humano revisa review-report.md"}}

  CP4 -->|"MERGE_WITH_FIXES
  Dev puede corregir"| REV_FIX

  CP4 -->|"DO_NOT_MERGE
  Rediseño requerido"| SUSPEND["📝 Tests QA → marcados @suspended
  en test-scenarios.md
  Coordinator registra: retrocede a FASE 1"]
  SUSPEND --> ARCH_IN

  %% ══════════════════════════════════════════════════════
  %% TERMINALES
  %% ══════════════════════════════════════════════════════

  DONE(["✅  PIPELINE COMPLETADO
  GitHub Action post-merge:
  ▸ spec.md + design-decision.md → docs/decisions/{issue-N}/
  ▸ .pipeline/{issue-N}/ eliminado del repo"])

  BLOCKED(["⛔  PIPELINE BLOQUEADO
  Escribe: PIPELINE_BLOCKED.md
  con historial completo de intentos
  Pipeline pausado hasta intervención humana"])

  %% ══════════════════════════════════════════════════════
  %% ESTILOS
  %% ══════════════════════════════════════════════════════

  classDef agentNode    fill:#1e3a5f,stroke:#4a90d9,color:#fff
  classDef checkpointNode fill:#5c3000,stroke:#e67e22,color:#fff
  classDef stateNode    fill:#1a4731,stroke:#27ae60,color:#fff
  classDef pauseNode    fill:#2c2c00,stroke:#f1c40f,color:#fff
  classDef decisionNode fill:#2d2d2d,stroke:#95a5a6,color:#fff
  classDef doneNode     fill:#145a32,stroke:#2ecc71,color:#fff
  classDef blockedNode  fill:#5b1a1a,stroke:#e74c3c,color:#fff
  classDef diffNode     fill:#1a3a4a,stroke:#3498db,color:#fff
  classDef entryNode    fill:#2c2c4a,stroke:#9b59b6,color:#fff
  classDef phaseIn      fill:#0d1b2a,stroke:#4a90d9,color:#4a90d9

  class PO,ARCH,TL,QA,DEV,REV agentNode
  class CP1,CP2,CP3,CP4 checkpointNode
  class PO_STATE,ARCH_STATE,TL_STATE,QA_STATE,DEV_STATE,REV_OK_STATE,REV_BLOCK_STATE stateNode
  class PAUSE_1,PAUSE_2,PAUSE_3,PAUSE_4 pauseNode
  class ROUTE,PO_SCHEMA,ARCH_SCHEMA,TL_SCHEMA,QA_CHECK,DEV_RESULT,DEV_CLASSIFY,DEV_MAX,REV_ITER,REV_CYCLES,MAX1,MAX2,MAX3 decisionNode
  class DONE doneNode
  class BLOCKED blockedNode
  class DIFF1,DIFF2,DIFF3 diffNode
  class START,PHASE_JUMP entryNode
  class PO_IN,ARCH_IN,TL_IN,QA_IN,DEV_IN,REV_IN phaseIn
