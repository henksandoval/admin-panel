# Configuración general del diagrama
direction: right
vars: {
  primary: "#2563eb"
  secondary: "#475569"
  warning: "#eab308"
  error: "#ef4444"
  success: "#22c55e"
}

# Definición de clases (estilos reutilizables)
classes: {
  agent: {
    shape: component
    style: {
      fill: white
      stroke: ${primary}
      border-radius: 5
      shadow: true
    }
  }
  human_checkpoint: {
    shape: hexagon
    style: {
      fill: "#fef08a"
      stroke: ${warning}
      stroke-width: 2
    }
  }
  sub_agent: {
    shape: component
    style: {
      fill: "#f8fafc"
      stroke: ${secondary}
      stroke-dash: 5
    }
  }
}

# Título del diagrama
title: "Arquitectura Multi-Agente FSM (Flujo Lógico)" {
  shape: text
  style: { font-size: 24; bold: true }
}

# --- FASE 1: INTAKE & BACKLOG ---
Fase 1. Intake y Backlog: {
  style: { fill: transparent; stroke: ${secondary} }
  
  PA: Project Assistant {class: agent}
  PM: Product Manager {class: agent}
  CP1: Checkpoint 1\n(Aprobación Humana) {class: human_checkpoint}

  PA -> PM: PBI ID válido
  PM -> PM: NEEDS_REVISION\n(VUL-01: awaiting_human_input) {style: { stroke: ${error}; animated: true }}
  PM -> CP1: WAITING_FOR_APPROVAL
}

# --- FASE 2: DISEÑO Y SHIFT-LEFT QA ---
Fase 2. Diseño y Calidad Pre-Código: {
  style: { fill: transparent; stroke: ${secondary} }
  
  SA: Software Architect {class: agent}
  QA: QA Analyst {class: agent}
  TL: Tech Lead {class: agent}
  CP2_3: Checkpoint 2 & 3\n(Aprobación de Arquitectura) {class: human_checkpoint}

  SA -> QA: COMPLETED\n(Diseño propuesto)
  
  # Bucles Shift-Left
  QA -> SA: NEEDS_REVISION\n(VUL-04: design_not_testable) {style: { stroke: ${warning} }}
  QA -> TL: COMPLETED\n(Casos de prueba listos)
  
  TL -> SA: NEEDS_REVISION\n(VUL-10: design) {style: { stroke: ${warning} }}
  TL -> QA: NEEDS_REVISION\n(VUL-10: test-cases) {style: { stroke: ${warning} }}
  
  TL -> CP2_3: COMPLETED
}

# --- FASE 3: IMPLEMENTACIÓN Y REVISIÓN ---
Fase 3. Desarrollo y Code Review: {
  style: { fill: transparent; stroke: ${secondary} }
  
  DEV: Developer {class: agent}
  TD: Test Developer\n(Sub-agente) {class: sub_agent}
  CR: Code Reviewer {class: agent}
  CP4: Checkpoint 4\n(Merge Approval) {class: human_checkpoint}

  DEV <-> TD: Iteración de Tests\n(VUL-09: compilation_failed)
  DEV -> DEV: NEEDS_REVISION\n(VUL-08: escalation) {style: { stroke: ${warning} }}
  
  DEV -> CR: COMPLETED\n(Código listo)
  CR -> DEV: NEEDS_REVISION\n(review_fixes_required)
  
  CR -> CP4: WAITING_FOR_APPROVAL\n(DO_NOT_MERGE / MERGE_READY)
}

# --- CONEXIONES ENTRE FASES ---
Fase 1.CP1 -> Fase 2.SA: Aprobado
Fase 2.CP2_3 -> Fase 3.DEV: Aprobado

# Bucle Macro (VUL-05)
Fase 3.CP4 -> Fase 2.SA: DO_NOT_MERGE\n(Macro Rework Loop) {
  style: { 
    stroke: ${error}
    stroke-width: 2
    animated: true
  }
}

# Fin del proceso
Fase 3.CP4 -> FIN: MERGE_READY {
  style: { stroke: ${success}; stroke-width: 2 }
}
FIN {shape: circle; style: {fill: ${success}}}